# Database
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT - generate a secure 256-bit secret (e.g. openssl rand -base64 32)
JWT_SECRET=your-256-bit-jwt-secret-key-change-this-in-production

# Google OAuth2 - get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Mail (SMTP) - for Gmail, use an App Password (not your regular password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# AWS S3 - get from AWS IAM console
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# App
FRONTEND_URL=http://localhost:3000
